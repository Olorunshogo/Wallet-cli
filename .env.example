# Copy to `.env` and uncomment what you need: `cp .env.example .env`
#
# wallet-cli loads `.env` from the directory you run it in. Precedence:
# command-line flags > variables already in your environment > `.env`.
# `.env` is git-ignored; never commit real credentials or recovery words.

# === Network and storage

# regtest | signet | testnet | testnet4 | bitcoin (also: mainnet, main, test). Default: regtest.
WALLET_NETWORK=regtest

# Which named wallet to use (see `wallets`). Default: the one set with
# `wallets use`, or the only one. -w / --wallet on the command line.
# WALLET_NAME=alice

# Use the wallet in exactly this directory instead of a named one.
# WALLET_DATADIR=./my-wallet

# true: encrypt the recovery words with a password on `init` / `restore`.
# Required on mainnet.
# WALLET_ENCRYPT=false

# true: allow --network bitcoin. Off by default on purpose.
# WALLET_ALLOW_MAINNET=false

# === Node mode (every command and the TUI)

# external: your Bitcoin Core, using the RPC settings below (default).
#           If unreachable, the TUI opens offline and keeps retrying.
# local:    one regtest bitcoind shared by all your wallets, run by this app.
#           Started on demand, stopped when the last user exits (or pinned
#           with `wallet-cli node start`). Nothing to install. Regtest only.
# none:     no node; offline mode (sync/send are unavailable).
# WALLET_NODE=local

# The shared local node's data directory and RPC port (P2P uses port + 1).
# WALLET_NODE_DIR=./.wallet/regtest/node
# WALLET_NODE_PORT=18543

# === Bitcoin Core RPC
# Used with WALLET_NODE=external (the default) and by the `regtest` example.

# Default: http://127.0.0.1:<port for the network>
#   regtest 18443 · signet 38332 · testnet 18332 · testnet4 48332 · mainnet 8332
# WALLET_RPC_URL=http://127.0.0.1:18443

# Authenticate with the node's cookie file (recommended for a local node)...
# Default: ~/.bitcoin/<network>/.cookie
# WALLET_RPC_COOKIE=/home/you/.bitcoin/regtest/.cookie

# ...or with rpcuser / rpcpassword from bitcoin.conf (set both; overrides the cookie).
# WALLET_RPC_USER=bitcoin
# WALLET_RPC_PASS=change-me

# === Restore (`wallet-cli restore`)
# Secrets. Prefer typing them on the command line for one-off use; only put
# them here for throwaway regtest/signet wallets.

# WALLET_MNEMONIC="word1 word2 ... word12"
# WALLET_PASSPHRASE=

# === Output

# Any non-empty value turns off colors (spinners still show in a terminal).
# NO_COLOR=1

# === Logging

# Log level: error | warn | info | debug | trace, or per-module filters such as
# "wallet_rpc=debug". Default: warn for commands, info for the TUI (written to
# <datadir>/tui.log so it does not disturb the screen).
# RUST_LOG=warn

# === Throwaway bitcoind for `tui --demo`, the regtest example and tests
# By default Bitcoin Core 29.0 is downloaded once at build time. These are read
# by cargo and the test harness, NOT by wallet-cli's `.env` loading, so set
# them in your shell (e.g. `export BITCOIND_EXE=...`) before running cargo.

# Use this bitcoind binary instead of the downloaded one.
# BITCOIND_EXE=/usr/local/bin/bitcoind

# Skip the build-time download (then set BITCOIND_EXE or have bitcoind in PATH).
# BITCOIND_SKIP_DOWNLOAD=1

# Parent directory for the throwaway node data directories (e.g. a ramdisk).
# TEMPDIR_ROOT=/tmp
